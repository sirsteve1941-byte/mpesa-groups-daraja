new file mode 100644
index 0000000000000000000000000000000000000000..5910493598f56eab2c679595fabd2d32c11d16f5
--- /dev/null
+++ b/render.sandbox.yaml
@@ -0,0 +1,29 @@
+# SANDBOX-ONLY Render blueprint. Separate service + separate database from production.
+# Create it from the Render dashboard: New > Blueprint > pick this repo and the branch, set the blueprint path to render.sandbox.yaml.
+# It does not touch the existing production service (mpesa-groups-daraja) or its database.
+databases:
+  - name: mpesa-groups-sandbox-db
+    plan: free
+services:
+  - type: web
+    name: mpesa-groups-sandbox
+    runtime: node
+    branch: sandbox-hardening
+    buildCommand: npm install --include=dev && npm run build
+    startCommand: npm start
+    healthCheckPath: /api/health
+    envVars:
+      - key: DATABASE_URL
+        fromDatabase: { name: mpesa-groups-sandbox-db, property: connectionString }
+      - { key: MPESA_ENV, value: sandbox }
+      - { key: MPESA_BUSINESS_SHORTCODE, value: "174379" }
+      - { key: MPESA_TRANSACTION_TYPE, value: CustomerPayBillOnline }
+      - { key: MPESA_CALLBACK_URL, value: https://mpesa-groups-sandbox.onrender.com/api/mpesa/callback }
+      - { key: MPESA_CALLBACK_TOKEN, generateValue: true }
+      - { key: NODE_VERSION, value: 20 }
+      - { key: PRODUCTION_VERIFIED, value: "false" }
+      # Paste the SANDBOX app's key/secret and the sandbox passkey (Daraja portal > your sandbox app) in the dashboard only.
+      - { key: MPESA_CONSUMER_KEY, sync: false }
+      - { key: MPESA_CONSUMER_SECRET, sync: false }
+      - { key: MPESA_PASSKEY, sync: false }
+      - { key: ADMIN_PASSWORD, sync: false }
diff --git a/src/guard.ts b/src/guard.ts
new file mode 100644
index 0000000000000000000000000000000000000000..df85c5d4be2e870c5afb7327dd85570903d9b0aa
--- /dev/null
+++ b/src/guard.ts
@@ -0,0 +1,32 @@
+// Startup guard: keeps sandbox and live payment identifiers apart.
+// Pure function so it can be unit-tested; server.ts exits if it returns problems.
+export type Env = Record<string, string | undefined>;
+export const SANDBOX_SHORTCODE = '174379';
+export const LIVE_IDENTIFIERS = ['1739052']; // live Till; extend with LIVE_PAYMENT_IDENTIFIERS=a,b
+const SECRET_KEYS = new Set(['MPESA_CONSUMER_KEY', 'MPESA_CONSUMER_SECRET', 'MPESA_PASSKEY', 'MPESA_CALLBACK_TOKEN', 'ADMIN_PASSWORD']);
+
+export function guardProblems(E: Env): string[] {
+  const p: string[] = [];
+  const env = E.MPESA_ENV || 'sandbox';
+  if (env !== 'sandbox' && env !== 'production') return ['MPESA_ENV must be "sandbox" or "production"'];
+  const base = E.MPESA_BASE_URL || '';
+  if (env === 'sandbox') {
+    const live = [...LIVE_IDENTIFIERS, ...(E.LIVE_PAYMENT_IDENTIFIERS || '').split(',').map(s => s.trim()).filter(Boolean)];
+    if (E.MPESA_BUSINESS_SHORTCODE && E.MPESA_BUSINESS_SHORTCODE !== SANDBOX_SHORTCODE) p.push('sandbox MPESA_BUSINESS_SHORTCODE must be ' + SANDBOX_SHORTCODE);
+    if (E.MPESA_TILL_NUMBER && E.MPESA_TILL_NUMBER !== SANDBOX_SHORTCODE) p.push('sandbox MPESA_TILL_NUMBER must be unset or ' + SANDBOX_SHORTCODE);
+    if (E.MPESA_TRANSACTION_TYPE && E.MPESA_TRANSACTION_TYPE !== 'CustomerPayBillOnline') p.push('sandbox MPESA_TRANSACTION_TYPE must be CustomerPayBillOnline');
+    if (/safaricom\.co\.ke/i.test(base) && !/^https:\/\/sandbox\.safaricom\.co\.ke(\/|$)/i.test(base)) p.push('sandbox MPESA_BASE_URL must not point at the live Safaricom API');
+    for (const [k, v] of Object.entries(E)) {
+      if (!v || SECRET_KEYS.has(k)) continue;
+      if (live.some(id => new RegExp('(?<!\\d)' + id.replace(/[^\w]/g, '') + '(?!\\d)').test(v))) p.push(k + ' contains a live payment identifier (value not shown)');
+    }
+    const prodDb = (E.PRODUCTION_DB_HOST || '').trim();
+    if (prodDb && (E.DATABASE_URL || '').includes(prodDb)) p.push('sandbox DATABASE_URL points at the production database host');
+  } else {
+    if (E.MPESA_BUSINESS_SHORTCODE === SANDBOX_SHORTCODE) p.push('production must not use the sandbox shortcode ' + SANDBOX_SHORTCODE);
+    if (base && !/^https:\/\/api\.safaricom\.co\.ke(\/|$)/i.test(base)) p.push('production MPESA_BASE_URL must be unset or the live Safaricom API');
+    const sbDb = (E.SANDBOX_DB_HOST || '').trim();
+    if (sbDb && (E.DATABASE_URL || '').includes(sbDb)) p.push('production DATABASE_URL points at the sandbox database host');
+  }
+  return p;
+}
