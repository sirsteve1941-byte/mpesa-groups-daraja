+name: Tests (sandbox, throwaway Postgres)
+on:
+  workflow_dispatch:
+  push:
+    branches: [sandbox-hardening]
+permissions:
+  contents: read
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    services:
+      postgres:
+        image: postgres:16
+        env: { POSTGRES_PASSWORD: test, POSTGRES_DB: mpesa_test }
+        ports: ['5432:5432']
+        options: >-
+          --health-cmd "pg_isready -U postgres" --health-interval 5s --health-timeout 5s --health-retries 10
+    env:
+      DATABASE_URL: postgres://postgres:test@localhost:5432/mpesa_test
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with: { node-version: 22 }
+      - run: npm install --include=dev --no-audit --no-fund
+      - run: npm run typecheck
+      - run: npm test
+      - run: npm run test:integration
