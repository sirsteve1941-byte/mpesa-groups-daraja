+import { guardProblems } from '../src/guard'; import a from 'assert';
+const ok = { MPESA_ENV: 'sandbox', MPESA_BUSINESS_SHORTCODE: '174379', MPESA_TRANSACTION_TYPE: 'CustomerPayBillOnline', MPESA_CALLBACK_URL: 'https://sbx.example.test/api/mpesa/callback', DATABASE_URL: 'postgres://u:p@sandbox-db.internal/mpesa_sandbox' };
+const has = (E: any, text: string) => guardProblems(E).some(p => p.includes(text));
+a.deepStrictEqual(guardProblems(ok), []); a.deepStrictEqual(guardProblems({}), [], 'unset env behaves as sandbox with nothing configured');
+a.deepStrictEqual(guardProblems({ ...ok, MPESA_TILL_NUMBER: '174379', MPESA_BASE_URL: 'https://sandbox.safaricom.co.ke' }), []);
+a.deepStrictEqual(guardProblems({ ...ok, MPESA_BASE_URL: 'http://localhost:4010' }), []);
+// live identifiers must never appear in sandbox
+a.ok(has({ ...ok, MPESA_TILL_NUMBER: '1739052' }, 'MPESA_TILL_NUMBER'));
+a.ok(has({ ...ok, MPESA_BUSINESS_SHORTCODE: '1739052' }, 'SHORTCODE'));
+a.ok(has({ ...ok, SOME_OTHER_VAR: 'till=1739052' }, 'SOME_OTHER_VAR contains a live payment identifier'));
+a.ok(!guardProblems({ ...ok, SOME_OTHER_VAR: 'x' }).join().includes('1739052'), 'problem text must not echo the identifier');
+a.ok(!has({ ...ok, SOME_OTHER_VAR: '117390521' }, 'live payment identifier'), 'longer digit runs are not a match');
+a.ok(!has({ ...ok, MPESA_PASSKEY: 'abc1739052def' }, 'live payment identifier'), 'secret values are not scanned');
+a.ok(has({ ...ok, LIVE_PAYMENT_IDENTIFIERS: '999888', X: '999888' }, 'X contains a live payment identifier'));
+// other sandbox rules
+a.ok(has({ ...ok, MPESA_BUSINESS_SHORTCODE: '600000' }, 'SHORTCODE')); a.ok(has({ ...ok, MPESA_TRANSACTION_TYPE: 'CustomerBuyGoodsOnline' }, 'TRANSACTION_TYPE'));
+a.ok(has({ ...ok, MPESA_BASE_URL: 'https://api.safaricom.co.ke' }, 'live Safaricom API'));
+a.ok(has({ ...ok, PRODUCTION_DB_HOST: 'sandbox-db.internal' }, 'production database'));
+a.ok(has({ ...ok, MPESA_ENV: 'staging' }, 'MPESA_ENV'));
+// production side is the mirror image
+const prod = { MPESA_ENV: 'production', MPESA_BUSINESS_SHORTCODE: '600123', MPESA_TILL_NUMBER: '1739052', MPESA_TRANSACTION_TYPE: 'CustomerBuyGoodsOnline' };
+a.deepStrictEqual(guardProblems(prod), []); a.ok(has({ ...prod, MPESA_BUSINESS_SHORTCODE: '174379' }, 'sandbox shortcode'));
