{
 "name": "mpesa-groups",
 "version": "2.0.0",
 "engines": {
  "node": ">=18"
 },
 "scripts": {
  "dev": "tsx watch src/server.ts",
  "dev:client": "vite client",
  "build": "tsc -p tsconfig.json && vite build client",
  "start": "node dist/server.js",
  "test": "tsx test/lib.test.ts && tsx test/mpesa.test.ts",
  "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
  "lint": "npm run typecheck",
  "test:integration": "tsx test/integration.test.ts"
 },
 "dependencies": {
  "dotenv": "^16.4.5",
  "express": "^4.19.2",
  "express-rate-limit": "^7.4.0",
  "pg": "^8.12.0",
  "react": "^18.3.1",
  "react-dom": "^18.3.1"
 },
 "devDependencies": {
  "@types/express": "^4.17.21",
  "@types/node": "^20.14.0",
  "@types/pg": "^8.11.6",
  "@types/react": "^18.3.3",
  "@types/react-dom": "^18.3.0",
  "@vitejs/plugin-react": "^4.3.1",
  "tsx": "^4.16.0",
  "typescript": "^5.5.4",
  "vite": "^5.3.5"
 }
}